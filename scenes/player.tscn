[sub_resource type="GDScript" id="GDScript_g2els"]
resource_name = "stamina_bar"
script/source = "extends TextureProgressBar

@export var player: CharacterBody2D

func _on_stamina_changed(current_stamina: Variant, max_stamina: Variant) -> void:
	self.max_value = max_stamina
	self.value = current_stamina
"

